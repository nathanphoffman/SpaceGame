  "components": {
    "schemas": {
      "CommandBody": {
        "required": [
          "type",
          "planet",
          "buildingType",
          "element",
          "shipType",
          "count",
          "upgradeType",
          "from",
          "to",
          "ships",
          "cargo",
          "fleet",
          "itemId"
        ],
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "planet": {
            "type": [
              "null",
              "string"
            ]
          },
          "buildingType": {
            "type": [
              "null",
              "string"
            ]
          },
          "element": {
            "type": [
              "null",
              "string"
            ]
          },
          "shipType": {
            "type": [
              "null",
              "string"
            ]
          },
          "count": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "upgradeType": {
            "type": [
              "null",
              "string"
            ]
          },
          "from": {
            "type": [
              "null",
              "string"
            ]
          },
          "to": {
            "type": [
              "null",
              "string"
            ]
          },
          "ships": {
            "type": [
              "null",
              "object"
            ],
            "additionalProperties": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          },
          "cargo": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Resources"
              }
            ]
          },
          "fleet": {
            "type": [
              "null",
              "string"
            ]
          },
          "itemId": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "CreateGameRequest": {
        "required": [
          "name",
          "mode",
          "seed",
          "discordWebhookUrl"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": [
              "null",
              "string"
            ]
          },
          "mode": {
            "type": [
              "null",
              "string"
            ]
          },
          "seed": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "discordWebhookUrl": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "JoinGameRequest": {
        "required": [
          "code",
          "playerName"
        ],
        "type": "object",
        "properties": {
          "code": {
            "type": [
              "null",
              "string"
            ]
          },
          "playerName": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "Resources": {
        "required": [
          "iron",
          "hydrogen",
          "titanium",
          "helium3"
        ],
        "type": "object",
        "properties": {
          "iron": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "hydrogen": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "titanium": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "helium3": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "total": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "hasNegative": {
            "type": "boolean"
          }
        }
      },
      "SendFleetBody": {
        "required": [
          "from",
          "ships",
          "to",
          "cargo"
        ],
        "type": "object",
        "properties": {
          "from": {
            "type": [
              "null",
              "string"
            ]
          },
          "ships": {
            "type": [
              "null",
              "object"
            ],
            "additionalProperties": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          },
          "to": {
            "type": [
              "null",
              "string"
            ]
          },
          "cargo": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Resources"
              }
            ]
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "SpaceGame.Server"
    },
    {
      "name": "LobbyEndpoints"
    },
    {
      "name": "PlayEndpoints"
    }
  ]
